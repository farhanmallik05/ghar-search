# ==============================================================================
# Ghar Search — Environment Configuration Blueprint
# Copy this file to .env.local (frontend, Landing Page) and .env (worker, root) and fill in credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Dual-App Web Applications Configuration
# ------------------------------------------------------------------------------
# Frontend App (Due Diligence Console)
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standalone Landing Page (Scrollytelling & Marketing Layer)
LANDING_PAGE_PORT=3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Supabase Configuration (Region: ap-south-1 Mumbai)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# TinyFish Web Agent APIs
# ------------------------------------------------------------------------------
TINYFISH_API_KEY=your-tinyfish-api-key-here
TINYFISH_BASE_URL=https://api.tinyfish.io/v1

# ------------------------------------------------------------------------------
# Large Language Models
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# Worker & Gateway Configuration
# ------------------------------------------------------------------------------
WORKER_PORT=8000
WORKER_HOST=0.0.0.0
WORKER_URL=http://localhost:8000
NEXT_PUBLIC_WORKER_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Shared Security & Webhook Secrets
# ------------------------------------------------------------------------------
INTERNAL_SECRET=ghar_search_internal_secure_secret_token_2026
CRON_SECRET=ghar_search_pg_cron_nightly_secret_token_2026
ENVIRONMENT=development
LOG_LEVEL=INFO
